[ButtonBehaviour]
LockButtonBehaviourActiveInactive=false
ShowCloseOutlineOnHoverActive=false
ShowCloseOutlineOnHoverInactive=false
ShowCloseOutlineOnPressActive=false
ShowCloseOutlineOnPressInactive=false
ShowOutlineOnHoverActive=false
ShowOutlineOnHoverInactive=false
ShowOutlineOnPressActive=false
ShowOutlineOnPressInactive=false
VaryColorCloseIconInactive=LessTitleBar
VaryColorIconInactive=LessTitleBar

[ButtonColors]
ButtonBackgroundColorsActive=TitleBarTextNegativeClose
ButtonBackgroundColorsInactive=TitleBarTextNegativeClose
ButtonBackgroundOpacityActive=10
ButtonBackgroundOpacityInactive=10
ButtonOverrideColorsActiveClose={"BackgroundHover":["NegativeFullySaturated"],"BackgroundPress":["NegativeSaturated",80]}
ButtonOverrideColorsInactiveClose={"BackgroundHover":["NegativeFullySaturated"],"BackgroundPress":["NegativeSaturated",80]}
OnPoorIconContrastActive=Nothing
OnPoorIconContrastInactive=Nothing

[ButtonSizing]
ButtonCornerRadius=Custom
ButtonCustomCornerRadius=0
FullHeightButtonSpacingLeft=0
FullHeightButtonSpacingRight=0
FullHeightButtonWidthMarginRight=28
IntegratedRoundedRectangleBottomPadding=1
LockFullHeightButtonSpacingLeftRight=true

[Global]
LookAndFeelSet=org.kde.breezedark.desktop
RefreshedConfig=6.5.3

[SystemIconGeneration]
KlassyDarkIconThemeInherits=breeze-plus-dark
KlassyIconThemeInherits=breeze-plus

[TitleBarOpacity]
OpaqueMaximizedTitleBars=false
OverrideActiveTitleBarOpacity=true
OverrideInactiveTitleBarOpacity=true

[TitleBarSpacing]
LockTitleBarLeftRightMargins=false
PercentMaximizedTopBottomMargins=50
TitleBarBottomMargin=4.5
TitleBarLeftMargin=4
TitleBarTopMargin=4.5

[Windeco]
BoldButtonIcons=BoldIconsHiDpiOnly
ButtonIconStyle=StyleFluent
ButtonShape=ShapeFullHeightRectangle
ColorizeWindowOutlineWithButton=false
DrawTitleBarSeparator=false
IconSize=IconMedium
MatchTitleBarToApplicationColor=true
SystemIconSize=SystemIcon20
WindowCornerRadius=8

[WindowOutlineStyle]
WindowOutlineAccentColorOpacityInactive=41
WindowOutlineOverlap=false
WindowOutlineStyleActive=WindowOutlineAccentColor
WindowOutlineStyleInactive=WindowOutlineAccentColor
WindowOutlineThickness=1.5
