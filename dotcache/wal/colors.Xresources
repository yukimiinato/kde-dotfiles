! X colors.
! Generated by 'wal'
*foreground:        #f9d3dc
*background:        #1f010c
*.foreground:       #f9d3dc
*.background:       #1f010c
emacs*foreground:   #f9d3dc
emacs*background:   #1f010c
URxvt*foreground:   #f9d3dc
XTerm*foreground:   #f9d3dc
UXTerm*foreground:  #f9d3dc
URxvt*background:   [100]#1f010c
XTerm*background:   #1f010c
UXTerm*background:  #1f010c
URxvt*cursorColor:  #ffdde5
XTerm*cursorColor:  #ffdde5
UXTerm*cursorColor: #ffdde5
URxvt*borderColor:  [100]#1f010c

! Colors 0-15.
*.color0: #1f010c
*color0:  #1f010c
*.color1: #b1a4b6
*color1:  #b1a4b6
*.color2: #e19499
*color2:  #e19499
*.color3: #a7a8c3
*color3:  #a7a8c3
*.color4: #bea7b6
*color4:  #bea7b6
*.color5: #b1abba
*color5:  #b1abba
*.color6: #d6c4c9
*color6:  #d6c4c9
*.color7: #dbc4bb
*color7:  #dbc4bb
*.color8: #cda7b0
*color8:  #cda7b0
*.color9: #bbafc0
*color9:  #bbafc0
*.color10: #e6a2a7
*color10:  #e6a2a7
*.color11: #b2b3cb
*color11:  #b2b3cb
*.color12: #c6b2c0
*color12:  #c6b2c0
*.color13: #bbb6c3
*color13:  #bbb6c3
*.color14: #dccbd0
*color14:  #dccbd0
*.color15: #e0cbc4
*color15:  #e0cbc4

! Black color that will not be affected by bold highlighting.
*.color66: #1f010c
*color66:  #1f010c

! Xclock colors.
XClock*foreground: #f9d3dc
XClock*background: #1f010c
XClock*majorColor:  rgba:e0/cb/c4/ff
XClock*minorColor:  rgba:e0/cb/c4/ff
XClock*hourColor:   rgba:e0/cb/c4/ff
XClock*minuteColor: rgba:e0/cb/c4/ff
XClock*secondColor: rgba:e0/cb/c4/ff

! Set depth to make transparency work.
URxvt*depth: 32
